{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src6/**/*.ts", "scripts/**/*.ts", "scripts6/**/*.ts", "tests/**/*.ts", "tests6/**/*.ts", "learn/**/*.ts"],
  "exclude": ["src6/cordis", "src6/参考_src5"]
}
