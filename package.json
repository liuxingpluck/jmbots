{
  "name": "jmbots",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/entries/Main.ts serve",
    "serve6": "bun src6/Main.ts",
    "start": "bun run build:web && bun src/entries/Main.ts serve",
    "build:web": "bun web/Build.ts",
    "build:testpage": "bun testpage/Build.ts",
    "eval:models": "bun scripts/Eval_Models.ts",
    "swap": "bun scripts/Swap_Serve.ts",
    "release": "bun scripts/Build_Release.ts",
    "serve:bg": "bun scripts/Start_Serve.ts",
    "guard": "bun scripts/Guard.ts",
    "autostart": "bun scripts/Install_Autostart.ts",
    "release6": "bun scripts6/Build_Release.ts",
    "swap6": "bun scripts6/Swap_Serve.ts",
    "guard6": "bun scripts6/Guard.ts",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p web/tsconfig.json && tsc -p testpage/tsconfig.json",
    "test": "bun test ./tests ./tests6",
    "dev:hold": "bun scripts/Dev_Hold.ts",
    "guard:restart": "bun scripts/Guard_Restart.ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\" package.json tsconfig.json tsconfig.check.json eslint.config.mjs .prettierrc.json .vscode/launch.json .vscode/tasks.json .vscode/settings.json .vscode/extensions.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\" package.json tsconfig.json tsconfig.check.json eslint.config.mjs .prettierrc.json .vscode/launch.json .vscode/tasks.json .vscode/settings.json .vscode/extensions.json",
    "lint": "eslint \"src/**/*.ts\" \"web/**/*.{ts,tsx}\" \"testpage/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"scripts6/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"src6/**/*.ts\" \"tests6/**/*.ts\" \"learn/**/*.ts\" eslint.config.mjs --max-warnings 0",
    "lint:budget": "eslint -c eslint.budget.config.mjs --no-error-on-unmatched-pattern \"src6/**/*.ts\""
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@earendil-works/pi-ai": "1.4.0",
    "@floating-ui/dom": "1.8.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@tiptap/core": "3.32.3",
    "cordis": "4.0.0-rc.12",
    "@tiptap/extensions": "3.32.3",
    "@tiptap/markdown": "3.32.3",
    "@tiptap/pm": "3.32.3",
    "@tiptap/react": "3.32.3",
    "@tiptap/starter-kit": "3.32.3",
    "@tiptap/suggestion": "3.32.3",
    "antd": "6.6.5",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.2"
  }
}
