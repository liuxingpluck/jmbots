# 白名单（用户 11-02 定）：只有代码和让代码跑起来的配置进 git；
# docs、.claude、diagrams、bak、ztools、runtime、各种笔记和产物一律不进。要加新的顶层目录，在下面加一行 !/名字/。
/*
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/package.json
!/tsconfig.json
!/eslint.config.mjs
!/.editorconfig
!/.prettierrc.json
!/.prettierignore
!/config.example.yaml
!/prompts/
!/memorycli/
!/src/
!/scripts/
!/tests/
!/local/
!/web/
!/shell/
/shell/*
/shell/**/*
!/shell/**/
!/shell/**/*.go
!/shell/go.mod
!/shell/go.sum
!/shell/README.md
/shell/**/*.exe

# 第 7 版骨架。
!/src7/

# 行号检查进 git（决策图 q-doc-lines）：ztools 里有令牌文件，只放开 check-lines，别的一律不进。
!/ztools/
/ztools/*
!/ztools/check-lines/

# 白名单目录里也不要的。
node_modules/
dist/
.env
.env.*
*.log
*.tmp
config.yaml
*.local.yaml
secrets.yaml

# 调试用的运行时（.vscode/launch.json 的“调试 HTTP 一条线”，docs/12_调试HTTP一条线.md）
.debug/

# 数据库文件不进 git（白名单目录里出现了也挡住）
*.db
*.sqlite
